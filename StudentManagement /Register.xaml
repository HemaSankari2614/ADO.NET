 <Window x:Class="Practiceforunstd2.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management System"
        Height="760" Width="1200"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Input Style -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D9E1EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#172554"
                CornerRadius="12"
                Padding="24"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="STUDENT MANAGEMENT"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Manage student records • ADO.NET CRUD Operations"
                               FontSize="13"
                               Foreground="#CBD5E1"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#263B70"
                        CornerRadius="8"
                        Padding="14,10"
                        VerticalAlignment="Center">

                    <TextBlock Text="ADMIN PANEL"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="Bold"/>
                </Border>

            </Grid>
        </Border>

        <!-- STUDENT FORM -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="22"
                Margin="0,0,0,20"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <StackPanel>

                <TextBlock Text="Student Information"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="#172554"/>

                <TextBlock Text="Enter the student details below"
                           FontSize="12"
                           Foreground="#64748B"
                           Margin="0,5,0,18"/>

                <!-- ROW 1 -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Student ID"
                                   Style="{StaticResource LabelStyle}"/>


                        <TextBox x:Name="txtstudnetid"
                                 Style="{StaticResource InputStyle}"
                                 ToolTip="Enter student name"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Full Name"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox x:Name="txtName"
                                 Style="{StaticResource InputStyle}"
                                 ToolTip="Enter student name"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Email Address"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox x:Name="txtEmail"
                                 Style="{StaticResource InputStyle}"
                                 ToolTip="Enter email address"/>
                    </StackPanel>
                </Grid>

                <!-- ROW 2 -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Department"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox x:Name="txtDepartment"
                                 Style="{StaticResource InputStyle}"
                                 ToolTip="Enter department"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Age"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox x:Name="txtAge"
                                 Style="{StaticResource InputStyle}"
                                 ToolTip="Enter student age"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Phone Number"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox x:Name="txtPhone"
                                 Style="{StaticResource InputStyle}"
                                 ToolTip="Enter phone number"/>
                    </StackPanel>
                </Grid>

                <!-- ACTION BUTTONS -->
                <WrapPanel>

                    <Button x:Name="btnAdd"
                            Content="+  Add Student"
                            Style="{StaticResource ActionButton}"
                            Background="#2563EB"
                            Click="btnAdd_Click"/>

                    <Button x:Name="btnviewstudent"
                            Content="↻  Read Students"
                            Style="{StaticResource ActionButton}"
                            Background="#0F766E"
                            Click="btnviewstudent_Click"/>

                    <Button x:Name="btnUpdate"
                            Content="✎  Update Student"
                            Style="{StaticResource ActionButton}"
                            Background="#D97706"
                            Click="btnUpdate_Click"/>

                    <Button x:Name="btnDelete"
                            Content="✕  Delete Student"
                            Style="{StaticResource ActionButton}"
                            Background="#DC2626"
                            Click="btnDelete_Click"/>

                    <Button x:Name="btnClear"
                            Content="Clear Form"
                            Height="40"
                            Padding="14,0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#334155"
                            Background="#E2E8F0"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnClear_Click"/>

                </WrapPanel>

            </StackPanel>
        </Border>

     

      

    </Grid>
</Window>
